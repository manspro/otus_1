{
  "info": {
    "name": "OTUS Dating App - Monolith vs Microservices",
    "description": "Демонстрация миграции от монолита к микросервисам. Сравнение полнофункционального монолита с выделенным dialog-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "dialog_service_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "friend_id",
      "value": ""
    },
    {
      "key": "post_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', response.id);",
                  "    console.log('User registered with ID:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Иван\",\n  \"second_name\": \"Иванов\",\n  \"birthdate\": \"1990-01-01\",\n  \"biography\": \"Люблю путешествовать и читать книги\",\n  \"city\": \"Москва\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/register",
              "host": ["{{base_url}}"],
              "path": ["user", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Login successful, token set');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "Monolith - Full Dating App (Port 3000)",
      "description": "Полнофункциональное приложение со всеми возможностями: пользователи, друзья, посты, диалоги",
      "item": [
        {
          "name": "Monolith - Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Сообщение из монолита!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dialog/{{friend_id}}/send",
              "host": ["{{base_url}}"],
              "path": ["dialog", "{{friend_id}}", "send"]
            }
          }
        },
        {
          "name": "Monolith - Get Dialog Messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/dialog/{{friend_id}}/list",
              "host": ["{{base_url}}"],
              "path": ["dialog", "{{friend_id}}", "list"]
            }
          }
        },
        {
          "name": "Monolith - Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Пост из монолита!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/post/create",
              "host": ["{{base_url}}"],
              "path": ["post", "create"]
            }
          }
        },
        {
          "name": "Monolith - Get User Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/get/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["user", "get", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Dialog Microservice - Only Dialogs (Port 3001)",
      "description": "Отдельный микросервис только для диалогов. Демонстрация выделенной функциональности.",
      "item": [
        {
          "name": "Microservice - Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{user_id}}",
                "description": "ID пользователя передается через заголовок (в реальности - через JWT или другую аутентификацию)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Сообщение из микросервиса!\"\n}"
            },
            "url": {
              "raw": "{{dialog_service_url}}/dialog/{{friend_id}}/send",
              "host": ["{{dialog_service_url}}"],
              "path": ["dialog", "{{friend_id}}", "send"]
            }
          }
        },
        {
          "name": "Microservice - Get Dialog Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{dialog_service_url}}/dialog/{{friend_id}}/list",
              "host": ["{{dialog_service_url}}"],
              "path": ["dialog", "{{friend_id}}", "list"]
            }
          }
        },
        {
          "name": "Microservice - Get All Dialogs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{dialog_service_url}}/dialog/list",
              "host": ["{{dialog_service_url}}"],
              "path": ["dialog", "list"]
            }
          }
        },
        {
          "name": "Microservice - Swagger Documentation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{dialog_service_url}}/api",
              "host": ["{{dialog_service_url}}"],
              "path": ["api"]
            }
          }
        }
      ]
    },
    {
      "name": "Users & Friends (Monolith)",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/get/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["user", "get", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Search Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.length > 0) {",
                  "        pm.collectionVariables.set('friend_id', response[0].id);",
                  "        console.log('Friend ID set to:', response[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Мария\",\n  \"last_name\": \"Петрова\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/search",
              "host": ["{{base_url}}"],
              "path": ["user", "search"]
            }
          }
        },
        {
          "name": "Add Friend",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/friend/set/{{friend_id}}",
              "host": ["{{base_url}}"],
              "path": ["friend", "set", "{{friend_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts (Monolith)",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('post_id', response.id);",
                  "    console.log('Post created with ID:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Мой первый пост в микросервисной архитектуре!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/post/create",
              "host": ["{{base_url}}"],
              "path": ["post", "create"]
            }
          }
        },
        {
          "name": "Get Post Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/post/feed?offset=0&limit=10",
              "host": ["{{base_url}}"],
              "path": ["post", "feed"],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
